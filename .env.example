# Environment Variables Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Token (required for Telegram integration)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Replay pending Telegram updates that arrived while bot was offline (default: 1)
TELEGRAM_REPLAY_PENDING_UPDATES_ON_STARTUP=1
# Optional startup replay limits (batch size <= 100)
# TELEGRAM_PENDING_UPDATES_BATCH_SIZE=100
# TELEGRAM_PENDING_UPDATES_MAX_BATCHES=5

# NVIDIA API Key (optional - has fallback in code)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Model ID for the AI model (optional - has fallback in code)
MODEL_ID=moonshotai/kimi-k2.6
# Alternative model slots (resolve to MODEL_ID if unset):
# ADVISOR_MODEL / MAIN_MODEL — user-facing primary model (defaults to MODEL_ID)
# EXECUTOR_MODEL / PREFLIGHT_MODEL — tool-execution model (defaults to MODEL_ID)
# REVIEWER_MODEL — peer-review model (falls back: REVIEWER → ADVISOR → MAIN → MODEL_ID)
# CONSORTIUM_MODEL — consortium member model (defaults to MODEL_ID)
#
# Recommended models (all available via NVIDIA API, May 2026):
#   Agentic:  nvidia/nemotron-3-super-120b-a12b  (tool calling, planning, coding)
#             deepseek-ai/deepseek-v4-pro          (1M ctx, MoE, coding)
#             z-ai/glm-5.1                         (agentic workflows)
#             qwen/qwen3.5-122b-a10b               (agent-ready, tool calling)
#   General:  moonshotai/kimi-k2-instruct-0905     (default, proven)
#             nvidia/llama-3.3-nemotron-super-49b-v1.5
#             nvidia/llama-3.1-nemotron-ultra-253b-v1
#             qwen/qwen3-next-80b-a3b-instruct
#             minimaxai/minimax-m2.7
#   Multimodal:
#             moonshotai/kimi-k2.5 / kimi-k2.6
#             meta/llama-4-maverick-17b-128e-instruct
#             meta/llama-3.2-90b-vision-instruct
#             google/gemma-4-31b-it
#             mistralai/mistral-small-4-119b-2603
#   Free tier: z-ai/glm-4.7 (tool calling), deepseek-ai/deepseek-v3.1-terminus

# OpenAI-compatible client endpoint (takes priority over NVIDIA when set)
# OPENAI_CLIENT_BASE_URL=https://api.openai.com/v1/chat/completions
# OPENAI_CLIENT_API_KEY=sk-your_openai_api_key_here
# OPENAI_CLIENT_MODEL=gpt-4o  # optional; falls back to MODEL_ID if unset
# Max number of inbound image attachments to pass to the model per message (default: 8)
MAX_IMAGE_ATTACHMENTS_PER_MESSAGE=8
# Optional ImageMagick binary/path used for on-the-fly image -> JPEG conversion
# SENDBLUE_IMAGE_MAGICK_BIN=magick

# OpenAI-compatible API server (optional)
# Set OPENAI_COMPAT_ENABLED=1 to expose /v1/models and /v1/chat/completions
OPENAI_COMPAT_ENABLED=0
# Required when OPENAI_COMPAT_ENABLED=1. Clients must send this as Bearer token.
OPENAI_COMPAT_API_KEY=your_openai_compat_api_key_here
OPENAI_COMPAT_HOST=0.0.0.0
OPENAI_COMPAT_PORT=8001
OPENAI_COMPAT_MODEL=agentzero-main

# ACP remote peer discovery (optional)
# Comma-separated ACP HTTP endpoints that expose /agents and /runs
# ACP_REMOTE_ENDPOINTS=http://acp-peer.local:8000

# Automatic memory capture cadence (target roughly 1 memory per 10-20 messages)
AUTO_MEMORY_ENABLED=1
AUTO_MEMORY_MIN_MESSAGES_PER_MEMORY=10
AUTO_MEMORY_TARGET_MESSAGES_PER_MEMORY=15
AUTO_MEMORY_MAX_MESSAGES_PER_MEMORY=20
# Near-duplicate threshold for auto memory capture dedupe (0.70-0.99)
AUTO_MEMORY_DEDUPE_THRESHOLD=0.90

# Speech pattern learning - adapt agent to match user's speaking style
# Messages to collect before extracting speech patterns (default: 8)
SPEECH_PATTERN_MIN_MESSAGES=8
# Messages between pattern updates (default: 15)
SPEECH_PATTERN_UPDATE_INTERVAL=15

# Agent Skills discovery and activation
AGENTZERO_SKILLS_ENABLED=1
# Project-level skill trust gate (set 0 to disable loading repo-provided skills)
AGENTZERO_TRUST_PROJECT_SKILLS=1
# User-level skills from ~/.agentzero/skills and ~/.agents/skills
AGENTZERO_ENABLE_USER_SKILLS=1
# Built-in skills packaged with AgentZero (includes default skill-creator)
AGENTZERO_ENABLE_BUILTIN_SKILLS=1
# Optional override for builtin skill root
# AGENTZERO_BUILTIN_SKILLS_DIR=/abs/path/to/skills
# Compatibility scan for ~/.claude/skills and ./.claude/skills
AGENTZERO_SCAN_CLAUDE_SKILLS=1
# Optional comma-separated disabled skills, e.g. "legacy-skill,unsafe-skill"
# AGENTZERO_DISABLED_SKILLS=

# Sendblue iMessage Integration (optional)
SENDBLUE_API_KEY=your_sendblue_api_key_here
SENDBLUE_API_SECRET=your_sendblue_api_secret_here
SENDBLUE_NUMBER=your_sendblue_number_here
# SENDBLUE_WEBHOOK_PORT=8080 # Set this to enable webhooks instead of polling
SENDBLUE_POLL_INTERVAL=10
# Replay recent inbound messages after reconnect (default: enabled)
SENDBLUE_STARTUP_REPLAY_ENABLED=1
# Seconds of startup lookback to detect messages received while offline (default: 21600)
SENDBLUE_STARTUP_LOOKBACK_SECONDS=21600
# Prefer replaying unread messages only when read state is available (default: 1)
SENDBLUE_STARTUP_UNREAD_ONLY=1
# If Sendblue omits read state, still replay recent inbound messages (default: 1)
SENDBLUE_STARTUP_REPLAY_UNKNOWN_READ_STATE=1
# Optional processed-handle dedupe TTL for polling/webhook paths (default: 60)
# SENDBLUE_DEDUP_TTL_SECONDS=60
# Enable iMessage voice memo transcription (default: 1)
SENDBLUE_VOICE_MEMO_TRANSCRIPTION_ENABLED=1
# NVIDIA Riva gRPC endpoint and function-id for NVIDIA parakeet-ctc-0_6b-asr
SENDBLUE_VOICE_MEMO_GRPC_SERVER=grpc.nvcf.nvidia.com:443
SENDBLUE_VOICE_MEMO_FUNCTION_ID=d8dd4e9b-fbf5-4fb0-9dba-8cf436c8d965
# Optional model override (usually routed by function-id)
# SENDBLUE_VOICE_MEMO_MODEL=
# Optional language hint (default: en-US for parakeet-ctc-0_6b-asr)
SENDBLUE_VOICE_MEMO_LANGUAGE=en-US
# Optional ffmpeg binary/path used to convert iMessage .m4a/.caf voice memos when needed
# SENDBLUE_VOICE_MEMO_FFMPEG_BIN=ffmpeg
# Max attachment size in bytes for transcription (default 25MB)
SENDBLUE_VOICE_MEMO_MAX_BYTES=26214400
